# Copy to .env (ignored by Git) and fill in. See README.md.

# Hetzner Cloud API token with Read & Write access.
HCLOUD_TOKEN=

# Tailscale auth key. Prefer a tagged, one-off key (see README.md).
TAILSCALE_AUTH_KEY=

# Email for Let's Encrypt expiry notices.
ACME_EMAIL=

# Your blog's domain. Leave empty to use <ip>.sslip.io for a quick trial.
GHOST_DOMAIN=

# Public key installed for root. SSH only works through the tunnel.
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Owner account for Ghost. It is created during the deploy, so nobody else can
# claim it. The password is generated and saved to .owner-password.
#GHOST_OWNER_EMAIL=         # defaults to ACME_EMAIL
#GHOST_TITLE="My Blog"

# Optional overrides.
#SERVER_TYPE=cx23
#LOCATION=fsn1
#VOLUME_SIZE_GB=20
#SERVER_NAME=ghost
